# Mộc POS – production settings for docker-compose.yml. Copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
# NEVER commit .env. Values with special characters: use the generators shown (hex only).

# ---- Domain (bought by the owner, added to Cloudflare) ----
DOMAIN=pos.example.vn

# ---- Images (built and pushed by GitHub Actions on main) ----
IMAGE_PREFIX=ghcr.io/ndhuy-sg
# "latest" = newest build of main. Pin a commit SHA tag (e.g. sha-1a2b3c4) to roll back.
IMAGE_TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=mocpos
POSTGRES_DB=mocpos
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Cloudflare Tunnel (docs/DEPLOY.md step 6) ----
# cloudflared tunnel token mocpos
CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARED_TAG=2026.11.1

# ---- Backups to Cloudflare R2 (docs/DEPLOY.md step 7) ----
# Turn on once the R2 bucket and token exist.
BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=mocpos-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_PREFIX=mocpos
# openssl rand -hex 32   — WRITE IT DOWN OFFLINE. Without this key the backups cannot be read.
BACKUP_ENCRYPTION_KEY=
# Nightly full backup time (Vietnam time) and how many nightly backups to keep (= days).
BACKUP_TIME=02:30
BACKUP_RETENTION_FULL=30
# Optional dead-man switch pinged after each nightly backup, e.g. https://hc-ping.com/<uuid>
BACKUP_HEARTBEAT_URL=
